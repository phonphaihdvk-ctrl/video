<!DOCTYPE html>
<html lang="km" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>HD Media Vault - 5TB Cloud</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@300;400;500;600;700&display=swap');
        * {
            font-family: 'Kantumruy Pro', Khmer, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        /* Custom Mobile Scrollbar Hide */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between selection:bg-blue-600 selection:text-white">

    <!-- App Mobile Frame Container -->
    <div class="w-full max-w-md mx-auto min-h-screen flex flex-col bg-slate-900 border-x border-slate-800 shadow-2xl relative overflow-hidden">
        
        <!-- Header -->
        <header class="bg-slate-900/90 backdrop-blur-md border-b border-slate-800 sticky top-0 z-40 px-4 py-3">
            <div class="flex items-center justify-between gap-2">
                
                <!-- Left: Sidebar Toggle & App Title -->
                <div class="flex items-center gap-2.5">
                    <button onclick="toggleSidebar()" class="p-2 rounded-xl bg-slate-800 text-slate-300 hover:text-white">
                        <i class="fa-solid fa-bars text-sm"></i>
                    </button>
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center text-white font-bold shadow-md shadow-blue-600/30">
                            <i class="fa-solid fa-photo-film text-xs"></i>
                        </div>
                        <div>
                            <h1 class="font-bold text-sm text-white leading-tight">គ្រប់គ្រង media</h1>
                            <p class="text-[10px] text-emerald-400 font-medium">5TB Cloud Connected</p>
                        </div>
                    </div>
                </div>

                <!-- Right Tools -->
                <div class="flex items-center gap-1.5">
                    <button onclick="toggleLang()" class="px-2 py-1 rounded-lg bg-slate-800 border border-slate-700 text-[11px] font-bold text-slate-200">
                        <span id="langText">KM</span>
                    </button>
                    <div class="w-7 h-7 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs ring-2 ring-blue-500/30">
                        P
                    </div>
                </div>

            </div>

            <!-- Horizontal Scrollable Navigation Row (Image 6 Style) -->
            <nav class="flex items-center gap-2 mt-3 overflow-x-auto no-scrollbar py-1">
                <button onclick="switchTab('categories')" id="tabCat" class="px-3.5 py-1.5 rounded-xl bg-blue-600 text-white text-xs font-semibold shrink-0 shadow-md flex items-center gap-1.5">
                    <i class="fa-solid fa-folder-tree"></i> <span>ប្រភេទ</span>
                </button>
                <button onclick="switchTab('videos')" id="tabVid" class="px-3.5 py-1.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 text-xs font-semibold shrink-0 flex items-center gap-1.5">
                    <i class="fa-solid fa-video"></i> <span>វីដេអូ</span>
                </button>
                <button onclick="switchTab('photos')" id="tabPhoto" class="px-3.5 py-1.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 text-xs font-semibold shrink-0 flex items-center gap-1.5">
                    <i class="fa-solid fa-image"></i> <span>រូបភាព</span>
                </button>
                <button onclick="switchTab('favorites')" id="tabFav" class="px-3.5 py-1.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 text-xs font-semibold shrink-0 flex items-center gap-1.5">
                    <i class="fa-solid fa-heart text-rose-500"></i> <span>ចំណង់ចូលចិត្ត</span>
                </button>
                <button onclick="switchTab('history')" id="tabHist" class="px-3.5 py-1.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 text-xs font-semibold shrink-0 flex items-center gap-1.5">
                    <i class="fa-solid fa-clock-rotate-left"></i> <span>ប្រវត្តិមើល</span>
                </button>
                <button onclick="openUploadModal()" class="px-3.5 py-1.5 rounded-xl bg-emerald-600 text-white text-xs font-semibold shrink-0 flex items-center gap-1.5 shadow-md">
                    <i class="fa-solid fa-cloud-arrow-up"></i> <span>បញ្ចូល Media</span>
                </button>
            </nav>
        </header>

        <!-- Sidebar Drawer (Google Drive 5TB Info) -->
        <div id="sidebarOverlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/80 z-50 hidden backdrop-blur-sm"></div>
        <aside id="sidebar" class="fixed top-0 left-0 h-full w-72 bg-slate-900 border-r border-slate-800 z-50 transform -translate-x-full transition-transform duration-300 flex flex-col justify-between p-4">
            <div>
                <div class="flex justify-between items-center pb-3 border-b border-slate-800">
                    <span class="font-bold text-sm text-white">Google Drive 5TB</span>
                    <button onclick="toggleSidebar()" class="text-slate-400 p-1"><i class="fa-solid fa-xmark text-base"></i></button>
                </div>
                
                <div class="py-4 border-b border-slate-800 flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-sm">P</div>
                    <div class="overflow-hidden">
                        <div class="font-bold text-xs text-white truncate">Phon Phal</div>
                        <div class="text-[10px] text-slate-400 truncate">phonphaihdvk@gmail.com</div>
                    </div>
                </div>

                <div class="py-3 space-y-1 text-xs">
                    <button onclick="switchTab('categories'); toggleSidebar();" class="w-full text-left px-3 py-2 rounded-xl bg-slate-800 text-blue-400 font-semibold flex items-center gap-2.5">
                        <i class="fa-solid fa-hard-drive"></i> <span>My Drive (5TB)</span>
                    </button>
                    <button onclick="switchTab('favorites'); toggleSidebar();" class="w-full text-left px-3 py-2 rounded-xl text-slate-300 hover:bg-slate-800 flex items-center gap-2.5">
                        <i class="fa-solid fa-heart text-rose-500"></i> <span>ចំណង់ចូលចិត្ត</span>
                    </button>
                    <button onclick="switchTab('history'); toggleSidebar();" class="w-full text-left px-3 py-2 rounded-xl text-slate-300 hover:bg-slate-800 flex items-center gap-2.5">
                        <i class="fa-solid fa-clock-rotate-left"></i> <span>ប្រវត្តិទស្សនា</span>
                    </button>
                </div>
            </div>

            <!-- Cloud Storage Status -->
            <div class="p-3 bg-slate-950 rounded-2xl border border-slate-800">
                <div class="flex justify-between text-xs font-semibold mb-1 text-slate-300">
                    <span><i class="fa-solid fa-cloud text-blue-500"></i> ទំហំសល់</span>
                    <span id="storageLabel">0.1% នៃ 5 TB</span>
                </div>
                <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden mb-2">
                    <div class="h-full bg-blue-500 rounded-full" style="width: 2%;"></div>
                </div>
                <p class="text-[10px] text-slate-500 text-center">សល់ទំហំ 4.99 TB ទៀតសម្រាប់ប្រើប្រាស់</p>
            </div>
        </aside>

        <!-- Main Body Area -->
        <main class="flex-1 p-4 overflow-y-auto">

            <!-- Category Pills Bar -->
            <div class="flex items-center justify-between gap-2 mb-4 overflow-x-auto no-scrollbar" id="categoryPillBar">
                <!-- Dynamic Pills -->
            </div>

            <!-- VIEW 1: CATEGORIES -->
            <section id="categoriesView" class="block space-y-4">
                <div class="flex items-center justify-between">
                    <h2 class="font-bold text-sm text-white flex items-center gap-2">
                        <i class="fa-solid fa-folder-closed text-blue-500"></i>
                        <span>ប្រភេទ Media និង Folder</span>
                    </h2>
                    <button onclick="openCatModal()" class="text-xs text-blue-400 font-medium">+ កែឈ្មោះប្រភេទ</button>
                </div>
                <div class="grid grid-cols-1 gap-3" id="categoryCardsGrid"></div>
            </section>

            <!-- VIEW 2: MEDIA GRID (VIDEOS / PHOTOS / FAVORITES / HISTORY) -->
            <section id="mediaView" class="hidden space-y-4">
                <div class="flex items-center justify-between">
                    <h2 class="font-bold text-sm text-white flex items-center gap-2">
                        <i id="mediaViewIcon" class="fa-solid fa-video text-blue-500"></i>
                        <span id="mediaViewTitle">វីដេអូទាំងអស់</span>
                    </h2>
                    <span class="text-xs text-slate-400" id="mediaTotalText">0 Item</span>
                </div>

                <div class="grid grid-cols-1 gap-3" id="mediaGrid"></div>

                <div id="emptyMediaMsg" class="hidden text-center py-12 bg-slate-800/40 rounded-2xl border border-dashed border-slate-800">
                    <i class="fa-solid fa-box-open text-3xl text-slate-600 mb-2"></i>
                    <p class="text-xs text-slate-400">មិនទាន់មានទិន្នន័យនៅឡើយទេ</p>
                </div>
            </section>

        </main>

        <!-- Footer Storage Bar -->
        <footer class="bg-slate-900 border-t border-slate-800 py-2.5 px-4 text-[11px] text-slate-400 flex justify-between items-center">
            <span class="truncate"><i class="fa-brands fa-google-drive text-blue-400"></i> 5TB Cloud Drive</span>
            <span class="font-semibold text-slate-300">ប្រើអស់ 2.4 GB / 5000 GB</span>
        </footer>

    </div>

    <!-- Upload Selection Modal -->
    <div id="uploadModal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-t-3xl sm:rounded-2xl max-w-sm w-full p-5 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-bold text-sm text-white">ជ្រើសរើសប្រភេទបញ្ចូល (Upload)</h3>
                <button onclick="closeUploadModal()" class="text-slate-400 p-1"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <button onclick="triggerFileSelect('video')" class="p-4 rounded-2xl bg-slate-800 border border-slate-700 hover:border-blue-500 text-center flex flex-col items-center gap-2">
                    <i class="fa-solid fa-video text-2xl text-blue-500"></i>
                    <span class="text-xs font-semibold text-white">បញ្ចូល វីដេអូ</span>
                </button>
                <button onclick="triggerFileSelect('image')" class="p-4 rounded-2xl bg-slate-800 border border-slate-700 hover:border-emerald-500 text-center flex flex-col items-center gap-2">
                    <i class="fa-solid fa-image text-2xl text-emerald-500"></i>
                    <span class="text-xs font-semibold text-white">បញ្ចូល រូបភាព</span>
                </button>
            </div>
            <input type="file" id="mediaFileInput" class="hidden" onchange="handleFileSelected(event)">
        </div>
    </div>

    <!-- Media Player Modal -->
    <div id="playerModal" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-3">
        <div class="bg-slate-900 rounded-2xl max-w-md w-full overflow-hidden border border-slate-800 shadow-2xl">
            <div class="p-3 flex justify-between items-center border-b border-slate-800">
                <h3 class="font-bold text-xs text-white truncate" id="playerTitle">Media Preview</h3>
                <button onclick="closePlayerModal()" class="text-slate-400 p-1"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="aspect-video bg-black flex items-center justify-center" id="playerContainer">
                <!-- Dynamic Player or Image -->
            </div>
        </div>
    </div>

    <!-- Edit Category Modal -->
    <div id="catModal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-xs w-full p-5 shadow-2xl space-y-4">
            <h3 class="font-bold text-sm text-white">កែប្រែឈ្មោះប្រភេទ</h3>
            <div id="catInputList" class="space-y-3"></div>
            <div class="flex justify-end gap-2 pt-2">
                <button onclick="closeCatModal()" class="px-3 py-1.5 text-xs rounded-xl bg-slate-800 text-slate-300">បោះបង់</button>
                <button onclick="saveCategories()" class="px-3 py-1.5 text-xs rounded-xl bg-blue-600 text-white font-bold">រក្សាទុក</button>
            </div>
        </div>
    </div>

    <script>
        let currentLang = 'km';
        let currentTab = 'categories'; // categories, videos, photos, favorites, history
        let uploadType = 'video';

        let categories = [
            { id: 'cat1', nameKm: 'វីដេអូការងារ & ឯកសារ', nameEn: 'Work & Documents', icon: 'fa-briefcase' },
            { id: 'cat2', nameKm: 'វីដេអូផ្ទាល់ខ្លួន & ដើរលេង', nameEn: 'Personal & Travel', icon: 'fa-user' },
            { id: 'cat3', nameKm: 'រូបភាពកម្សាន្ត & តន្ត្រី', nameEn: 'Photos & Music', icon: 'fa-image' }
        ];

        let mediaList = [
            { id: 1, type: 'video', title: 'IMG_8992.MP4 - ការផ្លាស់ប្តូរលេខសម្ងាត់ក្នុង TMS', cat: 'cat1', size: '14.7 MB', date: 'Oct 24, 2026', isFav: true, src: 'https://www.w3schools.com/html/mov_bbb.mp4' },
            { id: 2, type: 'video', title: 'Angkor Wat Sunrise - Siem Reap 4K Drone', cat: 'cat2', size: '150.7 MB', date: 'Oct 22, 2026', isFav: false, src: 'https://www.w3schools.com/html/mov_bbb.mp4' },
            { id: 3, type: 'image', title: 'Koh_Rong_Sanloem_Island_Photo.JPG', cat: 'cat3', size: '3.2 MB', date: 'Oct 20, 2026', isFav: true, src: 'https://picsum.photos/600/400' }
        ];

        let watchHistory = [];

        window.onload = function() {
            renderPills();
            renderCategoryCards();
            renderMedia();
        };

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('-translate-x-full');
            document.getElementById('sidebarOverlay').classList.toggle('hidden');
        }

        function toggleLang() {
            currentLang = currentLang === 'km' ? 'en' : 'km';
            document.getElementById('langText').innerText = currentLang.toUpperCase();
            renderPills();
            renderCategoryCards();
            renderMedia();
        }

        function switchTab(tab) {
            currentTab = tab;
            const catSec = document.getElementById('categoriesView');
            const mediaSec = document.getElementById('mediaView');

            // Reset Nav Button Styles
            ['tabCat', 'tabVid', 'tabPhoto', 'tabFav', 'tabHist'].forEach(id => {
                document.getElementById(id).className = "px-3.5 py-1.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 text-xs font-semibold shrink-0 flex items-center gap-1.5";
            });

            if (tab === 'categories') {
                catSec.classList.remove('hidden');
                mediaSec.classList.add('hidden');
                document.getElementById('tabCat').className = "px-3.5 py-1.5 rounded-xl bg-blue-600 text-white text-xs font-semibold shrink-0 shadow-md flex items-center gap-1.5";
            } else {
                catSec.classList.add('hidden');
                mediaSec.classList.remove('hidden');

                if (tab === 'videos') {
                    document.getElementById('tabVid').className = "px-3.5 py-1.5 rounded-xl bg-blue-600 text-white text-xs font-semibold shrink-0 shadow-md flex items-center gap-1.5";
                    document.getElementById('mediaViewTitle').innerText = "វីដេអូទាំងអស់";
                    document.getElementById('mediaViewIcon').className = "fa-solid fa-video text-blue-500";
                } else if (tab === 'photos') {
                    document.getElementById('tabPhoto').className = "px-3.5 py-1.5 rounded-xl bg-blue-600 text-white text-xs font-semibold shrink-0 shadow-md flex items-center gap-1.5";
                    document.getElementById('mediaViewTitle').innerText = "រូបភាពទាំងអស់";
                    document.getElementById('mediaViewIcon').className = "fa-solid fa-image text-emerald-500";
                } else if (tab === 'favorites') {
                    document.getElementById('tabFav').className = "px-3.5 py-1.5 rounded-xl bg-blue-600 text-white text-xs font-semibold shrink-0 shadow-md flex items-center gap-1.5";
                    document.getElementById('mediaViewTitle').innerText = "ចំណង់ចូលចិត្ត (❤️)";
                    document.getElementById('mediaViewIcon').className = "fa-solid fa-heart text-rose-500";
                } else if (tab === 'history') {
                    document.getElementById('tabHist').className = "px-3.5 py-1.5 rounded-xl bg-blue-600 text-white text-xs font-semibold shrink-0 shadow-md flex items-center gap-1.5";
                    document.getElementById('mediaViewTitle').innerText = "ប្រវត្តិមើល";
                    document.getElementById('mediaViewIcon').className = "fa-solid fa-clock-rotate-left text-amber-500";
                }
            }
            renderMedia();
        }

        function renderPills() {
            const bar = document.getElementById('categoryPillBar');
            let html = `<button onclick="switchTab('categories')" class="px-3 py-1 rounded-lg text-[11px] font-semibold bg-blue-600 text-white shrink-0">ទាំងអស់</button>`;
            categories.forEach(c => {
                html += `<button onclick="switchTab('videos')" class="px-3 py-1 rounded-lg text-[11px] font-semibold bg-slate-800 border border-slate-700 text-slate-300 shrink-0">${c.nameKm}</button>`;
            });
            bar.innerHTML = html;
        }

        function renderCategoryCards() {
            const grid = document.getElementById('categoryCardsGrid');
            grid.innerHTML = '';

            categories.forEach(c => {
                const count = mediaList.filter(m => m.cat === c.id).length;
                const card = document.createElement('div');
                card.className = "bg-slate-800/80 border border-slate-700/70 rounded-2xl p-4 shadow-md flex items-center justify-between cursor-pointer hover:border-blue-500 transition";
                card.onclick = () => switchTab('videos');

                card.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-blue-600/20 text-blue-400 flex items-center justify-center text-base"><i class="fa-solid ${c.icon}"></i></div>
                        <div>
                            <h3 class="text-xs font-bold text-white">${c.nameKm}</h3>
                            <p class="text-[10px] text-slate-400">${count} ឯកសារ Media</p>
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-right text-xs text-slate-500"></i>
                `;
                grid.appendChild(card);
            });
        }

        function renderMedia() {
            const grid = document.getElementById('mediaGrid');
            const msg = document.getElementById('emptyMediaMsg');
            grid.innerHTML = '';

            let list = [];
            if (currentTab === 'videos') list = mediaList.filter(m => m.type === 'video');
            else if (currentTab === 'photos') list = mediaList.filter(m => m.type === 'image');
            else if (currentTab === 'favorites') list = mediaList.filter(m => m.isFav);
            else if (currentTab === 'history') list = watchHistory;
            else list = mediaList;

            document.getElementById('mediaTotalText').innerText = `${list.length} Item`;

            if (list.length === 0) {
                msg.classList.remove('hidden');
                return;
            } else {
                msg.classList.add('hidden');
            }

            list.forEach(m => {
                const card = document.createElement('div');
                card.className = "bg-slate-800/90 border border-slate-700/80 rounded-2xl overflow-hidden shadow-md flex flex-col";

                let mediaPreview = m.type === 'video' 
                    ? `<div class="relative bg-black aspect-video flex items-center justify-center cursor-pointer" onclick="openPlayer(${m.id})">
                        <div class="w-10 h-10 rounded-full bg-blue-600/90 text-white flex items-center justify-center shadow-lg"><i class="fa-solid fa-play ml-0.5"></i></div>
                       </div>`
                    : `<div class="relative aspect-video bg-slate-950 cursor-pointer overflow-hidden" onclick="openPlayer(${m.id})">
                        <img src="${m.src}" class="w-full h-full object-cover">
                       </div>`;

                card.innerHTML = `
                    ${mediaPreview}
                    <div class="p-3 flex justify-between items-start gap-2">
                        <div class="overflow-hidden">
                            <h4 class="font-bold text-xs text-white truncate" title="${m.title}">${m.title}</h4>
                            <div class="text-[10px] text-slate-400 mt-1">${m.date} • ${m.size}</div>
                        </div>
                        <button onclick="toggleFav(${m.id})" class="p-1.5 text-base">
                            <i class="fa-${m.isFav ? 'solid' : 'regular'} fa-heart ${m.isFav ? 'text-rose-500' : 'text-slate-500'}"></i>
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function toggleFav(id) {
            const item = mediaList.find(m => m.id === id);
            if (item) {
                item.isFav = !item.isFav;
                renderMedia();
            }
        }

        function openPlayer(id) {
            const item = mediaList.find(m => m.id === id);
            if (!item) return;

            // Add to history
            if (!watchHistory.some(h => h.id === item.id)) {
                watchHistory.unshift(item);
            }

            document.getElementById('playerTitle').innerText = item.title;
            const container = document.getElementById('playerContainer');

            if (item.type === 'video') {
                container.innerHTML = `<video src="${item.src}" controls autoplay class="w-full h-full"></video>`;
            } else {
                container.innerHTML = `<img src="${item.src}" class="max-h-full object-contain">`;
            }

            document.getElementById('playerModal').classList.remove('hidden');
        }

        function closePlayerModal() {
            document.getElementById('playerContainer').innerHTML = '';
            document.getElementById('playerModal').classList.add('hidden');
        }

        function openUploadModal() { document.getElementById('uploadModal').classList.remove('hidden'); }
        function closeUploadModal() { document.getElementById('uploadModal').classList.add('hidden'); }

        function triggerFileSelect(type) {
            uploadType = type;
            const input = document.getElementById('mediaFileInput');
            input.accept = type === 'video' ? 'video/*' : 'image/*';
            input.click();
        }

        function handleFileSelected(e) {
            const file = e.target.files[0];
            if (!file) return;

            const newItem = {
                id: Date.now(),
                type: uploadType,
                title: file.name,
                cat: 'cat1',
                size: (file.size / (1024 * 1024)).toFixed(1) + ' MB',
                date: 'ទើបបញ្ចូល',
                isFav: false,
                src: URL.createObjectURL(file)
            };

            mediaList.unshift(newItem);
            closeUploadModal();
            switchTab(uploadType === 'video' ? 'videos' : 'photos');
        }

        function openCatModal() {
            const list = document.getElementById('catInputList');
            list.innerHTML = '';
            categories.forEach(c => {
                list.innerHTML += `<input type="text" id="input-${c.id}" value="${c.nameKm}" class="w-full px-3 py-1.5 text-xs rounded-xl bg-slate-800 border border-slate-700 text-white">`;
            });
            document.getElementById('catModal').classList.remove('hidden');
        }

        function closeCatModal() { document.getElementById('catModal').classList.add('hidden'); }

        function saveCategories() {
            categories.forEach(c => {
                const val = document.getElementById(`input-${c.id}`).value;
                if (val) c.nameKm = val;
            });
            closeCatModal();
            renderPills();
            renderCategoryCards();
        }
    </script>
</body>
</html>